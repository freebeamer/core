<?xml version="1.0" encoding="utf-8"?>
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <title>Synthetic MEVD test definition</title>
    <description>Legally redistributable parser fixture.</description>
    <BASEOFFSET offset="0" subtract="0" future="preserved" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x000000" size="0x400000" regionflags="0x0" name="Binary File" desc="Entire image" />
    <CATEGORY index="0x0" name="Fuel" />
    <CATEGORY index="0x1" name="Boost" />
    <UNKNOWN future="safe"><NESTED /></UNKNOWN>
  </XDFHEADER>
  <XDFTABLE uniqueid="0x100" flags="0x0">
    <title>Boost target</title>
    <description>Example table</description>
    <CATEGORYMEM index="0" category="0x1" />
    <XDFAXIS id="x">
      <EMBEDDEDDATA mmedtypeflags="0x2" mmedaddress="0x100" mmedelementsizebits="16" mmedrowcount="1" mmedcolcount="2" mmedmajorstridebits="0" mmedminorstridebits="0" custom="kept" />
      <units>rpm</units><indexcount>2</indexcount><decimalpl>0</decimalpl><outputtype>1</outputtype>
      <MATH equation="X*10"><VAR id="X" /></MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedtypeflags="0x2" mmedaddress="0x200" mmedelementsizebits="16" mmedrowcount="2" mmedcolcount="2" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>kPa</units><decimalpl>2</decimalpl><outputtype>2</outputtype>
      <MATH equation="X*0.1" />
    </XDFAXIS>
    <FUTURE_ELEMENT ignored="yes" />
  </XDFTABLE>
  <XDFFLAG uniqueid="0x200">
    <title>Example switch</title><description>A bit flag</description>
    <CATEGORYMEM index="0" category="0x0" />
    <EMBEDDEDDATA mmedtypeflags="0x0" mmedaddress="0x300" mmedelementsizebits="8" />
    <MATH equation="X" />
  </XDFFLAG>
</XDFFORMAT>
