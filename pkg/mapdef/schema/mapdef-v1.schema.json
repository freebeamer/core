{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freehorse.dev/schemas/mapdef-v1.schema.json",
  "title": "FreeBeamer map definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "id", "name", "compatibility", "provenance", "memory", "parameters"],
  "properties": {
    "format": {"const": "freehorse.mapdef"},
    "formatVersion": {"enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"]},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "memory": {"$ref": "#/$defs/memory"},
    "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}},
    "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
    "checksumRequirements": {"type": "array", "items": {"$ref": "#/$defs/checksumRequirement"}},
    "importDiagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "stringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "manufacturers": {"$ref": "#/$defs/stringArray"},
        "ecuFamilies": {"$ref": "#/$defs/stringArray"},
        "softwareIds": {"$ref": "#/$defs/stringArray"},
        "imageSizes": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "author": {"type": "string"}, "license": {"type": "string"}, "source": {"type": "string"},
        "sourceFormat": {"type": "string"}, "sourceVersion": {"type": "string"},
        "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "convertedBy": {"type": "string"}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false, "required": ["baseOffset"],
      "properties": {
        "baseOffset": {"type": "integer"},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "start", "size"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string"},
        "start": {"type": "integer", "minimum": 0}, "size": {"type": "integer", "minimum": 0}, "type": {"type": "string"}
      }
    },
    "category": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}}
    },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "layout", "conversion"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["scalar", "flag", "curve", "map"]},
        "name": {"type": "string", "minLength": 1}, "description": {"type": "string"},
        "categories": {"$ref": "#/$defs/stringArray"}, "layout": {"$ref": "#/$defs/layout"},
        "axes": {
          "type": "object", "additionalProperties": false,
          "properties": {"x": {"$ref": "#/$defs/axis"}, "y": {"$ref": "#/$defs/axis"}}
        },
        "unit": {"type": "string"}, "conversion": {"$ref": "#/$defs/conversion"},
        "display": {"$ref": "#/$defs/display"}, "sourceMetadata": {"type": "object"}
      }
    },
    "layout": {
      "type": "object", "additionalProperties": false,
      "required": ["dataType", "byteOrder", "dimensions", "order"],
      "properties": {
        "address": {"type": "integer", "minimum": 0},
        "dataType": {"enum": ["uint8", "int8", "uint16", "int16", "uint32", "int32", "unknown"]},
        "byteOrder": {"enum": ["big", "little", "not-applicable", "unknown"]},
        "dimensions": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "order": {"enum": ["row-major", "column-major", "not-applicable", "unknown"]},
        "strideBits": {
          "type": "array", "items": {"type": "integer"},
          "description": "Per-dimension element-to-element distance in bits, overriding the data type's natural width. Only supported for a single-dimension axis layout (e.g. A2L RES_AXIS's interleaved rescale pairs, where the value element for point i sits 2x the natural width apart); a parameter's own Z layout still rejects any non-zero stride."
        },
        "bitPosition": {"type": "integer", "minimum": 0}
      }
    },
    "axis": {
      "type": "object", "additionalProperties": false, "required": ["count", "conversion"],
      "properties": {
        "count": {"type": "integer", "minimum": 1}, "layout": {"$ref": "#/$defs/layout"},
        "unit": {"type": "string"}, "conversion": {"$ref": "#/$defs/conversion"},
        "display": {"$ref": "#/$defs/display"},
        "staticValues": {"type": "array", "items": {"$ref": "#/$defs/staticValue"}},
        "fixedPoints": {
          "type": "array", "items": {"type": "integer"},
          "description": "Raw (pre-conversion) breakpoints for an axis with no on-disk storage at all (e.g. A2L FIX_AXIS, computed from a formula or literal list). Mutually exclusive with layout: exactly one of the two is present."
        },
        "sourceMetadata": {"type": "object"}
      }
    },
    "staticValue": {
      "type": "object", "additionalProperties": false, "required": ["index", "value"],
      "properties": {"index": {"type": "integer", "minimum": 0}, "value": {"type": "string"}}
    },
    "conversion": {
      "type": "object", "additionalProperties": false, "required": ["language"],
      "description": "Either a freehorse-expression-v1 arithmetic expression (expression set) or a freehorse-lookup-table-v1 numeric lookup table (points/interpolated set, mapdef 1.3+) — exactly one shape applies, selected by language.",
      "properties": {
        "language": {"enum": ["freehorse-expression-v1", "freehorse-lookup-table-v1"]},
        "expression": {"type": "string", "minLength": 1},
        "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conversionPoint"}},
        "interpolated": {"type": "boolean"},
        "default": {"type": "number"}
      }
    },
    "conversionPoint": {
      "type": "object", "additionalProperties": false, "required": ["input", "output"],
      "properties": {"input": {"type": "number"}, "output": {"type": "number"}}
    },
    "display": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "decimalPlaces": {"type": "integer", "minimum": -1, "description": "-1 is the XDF convention for unspecified/automatic precision."},
        "outputType": {"type": "integer", "minimum": 0},
        "min": {"type": "number", "description": "Informational display bound; not enforced as an edit-time range check."},
        "max": {"type": "number", "description": "Informational display bound; not enforced as an edit-time range check."}
      }
    },
    "checksumRequirement": {
      "type": "object", "additionalProperties": false, "required": ["provider", "required"],
      "properties": {"provider": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}}
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["info", "warning", "error"]}, "code": {"type": "string", "minLength": 1},
        "path": {"type": "string"}, "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
